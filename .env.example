# ---------------------------------------------------------------------------
# SocialDesk configuration. Copy to .env and fill in. Never commit real secrets.
# Every variable is validated at startup (src/server/env.ts); a bad value stops the
# app with a message naming the variable.
# ---------------------------------------------------------------------------

# Public URL of the app, without a trailing slash. Used in emails and OAuth callbacks.
APP_URL="http://localhost:3000"

# --- Database & cache -------------------------------------------------------
DATABASE_URL="postgresql://socialdesk:CHANGE_ME@localhost:5432/socialdesk"
REDIS_URL="redis://localhost:6379"

# --- Auth -------------------------------------------------------------------
# 32+ random characters:  openssl rand -base64 48
AUTH_SECRET="CHANGE_ME"
# Required behind a reverse proxy (Coolify/Traefik).
AUTH_TRUST_HOST=true
# Set to false to allow only invited users to register.
SIGNUPS_ENABLED=true

# --- Encryption -------------------------------------------------------------
# Encrypts stored social access tokens. Exactly 32 bytes, base64:  openssl rand -base64 32
# Changing it makes existing tokens unreadable (channels must be reconnected).
TOKEN_ENCRYPTION_KEY="CHANGE_ME"
# Signs short-lived media URLs that platforms fetch when publishing:  openssl rand -base64 48
MEDIA_SIGNING_SECRET="CHANGE_ME"

# --- Media storage ----------------------------------------------------------
# "local" stores files on a persistent volume. (An S3/R2 driver can be added behind the same interface.)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR="./storage"
MAX_IMAGE_MB=8
MAX_VIDEO_MB=200

# --- Email ------------------------------------------------------------------
# "log" prints emails to the console and .data/mail (development only). Use "smtp" in production.
MAIL_TRANSPORT=log
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE=false
MAIL_FROM="SocialDesk <no-reply@example.com>"

# --- Meta (Instagram + Facebook Pages) ----------------------------------------
# mock        = fake in-process adapters for local development, for EVERY platform (Meta, X,
#               LinkedIn, YouTube). Never publishes. Refused in production.
# development = real Graph API, Meta app in Development mode (only app roles/testers can connect).
# live        = real Graph API, app approved through Meta App Review.
META_MODE=mock
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"
# Defaults to ${APP_URL}/api/oauth/meta/callback. Must be listed in the Meta app's Valid OAuth Redirect URIs.
META_REDIRECT_URI=""

# --- X, LinkedIn, YouTube (optional) -------------------------------------------
# Each platform is offered once its app credentials are set (see docs/channels-setup.md).
# Redirect URIs to register: ${APP_URL}/api/oauth/x/callback, /api/oauth/linkedin/callback,
# /api/oauth/google/callback.
X_CLIENT_ID=""
X_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# Monthly LinkedIn API version (YYYYMM); each is supported for about a year.
LINKEDIN_API_VERSION="202608"
# true = also request company-page permissions (needs the Community Management API product).
LINKEDIN_PAGES=false

# --- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=2
PUBLISH_MAX_ATTEMPTS=4

# --- Billing (Razorpay) -------------------------------------------------------
# Leave disabled during the free beta. When enabled all three Razorpay values are required.
BILLING_ENABLED=false
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
